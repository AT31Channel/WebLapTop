@model WebLapTop.Models.Entities.Product
@{
    ViewData["Title"] = "Xóa sản phẩm";
}

<div class="container-fluid">
    <div class="card">
        <div class="card-header bg-danger text-white">
            <h5 class="card-title mb-0">Xác nhận xóa sản phẩm</h5>
        </div>
        <div class="card-body">
            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                Bạn có chắc chắn muốn xóa sản phẩm này? Hành động này không thể hoàn tác.
            </div>
            
            <div class="row">
                <div class="col-md-4">
                    <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid img-thumbnail mb-3" />
                </div>
                <div class="col-md-8">
                    <h4>@Model.Name</h4>
                    <p><strong>Mã sản phẩm:</strong> @Model.Id</p>
                    <p><strong>Danh mục:</strong> @Model.Category?.Name</p>
                    <p><strong>Giá:</strong> @Model.Price.ToString("N0") VNĐ</p>
                    <p><strong>Giá khuyến mãi:</strong> 
                        @if (Model.DiscountPrice.HasValue)
                        {
                            @Model.DiscountPrice.Value.ToString("N0") <text> VNĐ</text>
                        }
                        else
                        {
                            <span class="text-muted">Không giảm giá</span>
                        }
                    </p>
                    <p><strong>Trạng thái:</strong> 
                        @if (Model.IsAvailable)
                        {
                            <span class="badge bg-success">Còn hàng</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Hết hàng</span>
                        }
                    </p>
                    <p><strong>Nổi bật:</strong>
                        @if (Model.IsFeatured)
                        {
                            <span class="badge bg-primary">Có</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Không</span>
                        }
                    </p>
                    <p><strong>Ngày tạo:</strong> @Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
            </div>
            
            <div class="mt-4">
                <h5>Mô tả sản phẩm</h5>
                <p>@Model.Description</p>
            </div>
            
            <form asp-action="DeleteProduct" method="post" class="mt-4">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-between">
                    <a asp-action="Products" class="btn btn-secondary">Quay lại</a>
                    <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
                </div>
            </form>
        </div>
    </div>
</div> 