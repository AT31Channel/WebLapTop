@model IEnumerable<WebLapTop.Models.ViewModels.UserViewModel>
@{
    ViewData["Title"] = "Quản lý người dùng";
}

<style>
    .table td {
        color: #ffffff !important;
        background-color: rgba(0, 0, 0, 0.8) !important;
    }
    
    .user-role {
        display: inline-block;
        padding: 4px 8px;
        border-radius: 4px;
        font-weight: 500;
        margin: 2px;
        background-color: #1a237e;
        color: white;
    }

    .user-role.admin {
        background-color: #d32f2f;
    }

    .user-role.staff {
        background-color: #2e7d32;
    }

    .user-role.customer {
        background-color: #1976d2;
    }

    .user-info {
        color: #ffffff !important;
    }

    .phone-number {
        color: #2196f3 !important;
        font-weight: 500;
    }

    .btn-add-user {
        background: linear-gradient(45deg, #2196f3, #00bcd4);
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 5px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        transition: all 0.3s ease;
    }

    .btn-add-user:hover {
        background: linear-gradient(45deg, #1976d2, #0097a7);
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.3);
        color: white;
    }

    .btn-add-user i {
        margin-right: 8px;
    }
</style>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-white">Quản lý người dùng</h2>
        <a asp-action="CreateUser" class="btn-add-user">
            <i class="fas fa-user-plus"></i>
            Thêm người dùng mới
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card card-cyber">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Tên đăng nhập</th>
                            <th>Họ tên</th>
                            <th>Email</th>
                            <th>Số điện thoại</th>
                            <th>Vai trò</th>
                            <th width="250">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td class="user-info">@user.UserName</td>
                                <td class="user-info">@(string.IsNullOrEmpty(user.FullName) ? "-" : user.FullName)</td>
                                <td class="user-info">@user.Email</td>
                                <td class="phone-number">@(string.IsNullOrEmpty(user.PhoneNumber) ? "-" : user.PhoneNumber)</td>
                                <td>
                                    @foreach (var role in user.Roles)
                                    {
                                        @if (role == "Admin")
                                        {
                                            <span class="user-role admin">Quản trị viên</span>
                                        }
                                        else if (role == "Staff")
                                        {
                                            <span class="user-role staff">Nhân viên</span>
                                        }
                                        else if (role == "User")
                                        {
                                            <span class="user-role customer">Khách hàng</span>
                                        }
                                        else
                                        {
                                            <span class="user-role customer">Khách hàng</span>
                                        }
                                    }
                                    @if (!user.Roles.Any())
                                    {
                                        <span class="user-role customer">Khách hàng</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="UserDetails" asp-route-id="@user.Id" class="btn btn-outline-primary btn-sm">
                                            <i class="fas fa-info-circle"></i> Chi tiết
                                        </a>
                                        <a asp-action="EditUser" asp-route-id="@user.Id" class="btn btn-outline-warning btn-sm ms-1">
                                            <i class="fas fa-edit"></i> Sửa
                                        </a>
                                        @if (!user.Roles.Contains("Admin"))
                                        {
                                            <button onclick="confirmDelete('@user.Id', '@user.UserName')" class="btn btn-outline-danger btn-sm ms-1">
                                                <i class="fas fa-trash"></i> Xóa
                                            </button>
                                            @if (!user.Roles.Contains("Staff"))
                                            {
                                                <form asp-action="ToggleStaffRole" method="post" class="d-inline">
                                                    <input type="hidden" name="id" value="@user.Id" />
                                                    <button type="submit" class="btn btn-outline-info btn-sm ms-1" 
                                                            onclick="return confirm('Bạn có chắc muốn cấp quyền nhân viên cho người dùng này?')">
                                                        <i class="fas fa-user-tie"></i> Cấp quyền NV
                                                    </button>
                                                </form>
                                            }
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id, username) {
            Swal.fire({
                title: 'Xác nhận xóa?',
                text: `Bạn có chắc chắn muốn xóa tài khoản "${username}"?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Xóa',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = `/Admin/DeleteUser/${id}`;
                }
            });
        }
    </script>
} 