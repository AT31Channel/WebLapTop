@model IEnumerable<WebLapTop.Models.Entities.AdminNotification>

@{
    ViewData["Title"] = "Thông báo";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-dark"><i class="bi bi-bell me-2"></i>Thông báo hệ thống</h2>
        <div>
            <button id="refreshBtn" class="btn btn-outline-primary me-2">
                <i class="bi bi-arrow-clockwise me-1"></i>Làm mới
            </button>
            <a asp-action="Orders" class="btn btn-outline-primary">
                <i class="bi bi-arrow-left me-1"></i>Quay lại đơn hàng
            </a>
            <a asp-action="Index" class="btn btn-outline-primary ms-2">
                <i class="bi bi-house me-1"></i>Bảng điều khiển
            </a>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <i class="bi bi-bell-fill me-1"></i>Danh sách thông báo
        </div>
        <div class="card-body bg-white">
            @if (!Model.Any())
            {
                <div class="alert alert-info text-center">
                    <i class="bi bi-info-circle-fill me-2"></i>Không có thông báo nào!
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr class="text-dark">
                                <th>Tiêu đề</th>
                                <th>Nội dung</th>
                                <th>Ngày tạo</th>
                                <th>Trạng thái</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var notification in Model)
                            {
                                <tr class="@(notification.IsRead ? "text-dark" : "table-warning")">
                                    <td class="fw-bold">@notification.Title</td>
                                    <td>@notification.Message</td>
                                    <td>@notification.CreateDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @if (notification.IsRead)
                                        {
                                            <span class="badge bg-secondary text-white">Đã đọc</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Chưa đọc</span>
                                        }
                                    </td>
                                    <td>
                                        @if (notification.OrderId.HasValue)
                                        {
                                            <a asp-action="OrderDetails" asp-route-id="@notification.OrderId" 
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-eye"></i> Xem đơn hàng
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var table = $('table').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.10.25/i18n/Vietnamese.json"
                },
                "order": [[2, 'desc']]
            });

            // Làm mới trang
            $('#refreshBtn').click(function() {
                location.reload();
            });

            // Tự động làm mới sau mỗi 30 giây
            setInterval(function() {
                location.reload();
            }, 30000);
        });
    </script>
} 