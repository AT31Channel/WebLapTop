@using System.Linq
@model WebLapTop.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Bảng điều khiển";
}

<div class="container-fluid">
    <h2 class="mb-4">Bảng điều khiển</h2>

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <h5 class="card-title">Tổng đơn hàng</h5>
                    <h2 class="card-text">@Model.TotalOrders</h2>
                    <p class="card-text">đơn hàng</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <h5 class="card-title">Doanh thu</h5>
                    <h2 class="card-text">@Model.TotalRevenue.ToString("N0")</h2>
                    <p class="card-text">VNĐ</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-white">
                <div class="card-body">
                    <h5 class="card-title">Sản phẩm</h5>
                    <h2 class="card-text">@(Model.TopProducts.Count > 0 ? Model.TopProducts.Sum(p => p.TotalQuantity) : 0)</h2>
                    <p class="card-text">đã bán</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <h5 class="card-title">Khách hàng</h5>
                    <h2 class="card-text">@Model.TotalUsers</h2>
                    <p class="card-text">người dùng</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0">Trạng thái đơn hàng</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-3">
                        <span>Chờ xác nhận:</span>
                        <span class="badge bg-secondary">@Model.PendingOrders</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span>Đã xác nhận:</span>
                        <span class="badge bg-primary">@Model.ConfirmedOrders</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span>Đang giao hàng:</span>
                        <span class="badge bg-info">@Model.ShippingOrders</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span>Đã giao hàng:</span>
                        <span class="badge bg-success">@Model.DeliveredOrders</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span>Đã hủy:</span>
                        <span class="badge bg-danger">@Model.CancelledOrders</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0">Sản phẩm bán chạy</h5>
                </div>
                <div class="card-body">
                    @if (Model.TopProducts.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var product in Model.TopProducts)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div class="d-flex align-items-center">
                                        <img src="@product.ImageUrl" alt="@product.Name" class="img-thumbnail me-3" style="width: 50px; height: 50px; object-fit: cover;">
                                        <span>@product.Name</span>
                                    </div>
                                    <span class="badge bg-primary rounded-pill">@product.TotalQuantity</span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted">Chưa có dữ liệu sản phẩm bán chạy</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0">Đơn hàng gần đây</h5>
                </div>
                <div class="card-body">
                    @if (Model.RecentOrders.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Mã đơn</th>
                                        <th>Ngày đặt</th>
                                        <th>Khách hàng</th>
                                        <th>Tổng tiền</th>
                                        <th>Trạng thái</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in Model.RecentOrders)
                                    {
                                        <tr>
                                            <td>#@order.Id.ToString("D6")</td>
                                            <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>@order.FullName</td>
                                            <td>@order.TotalAmount.ToString("N0") VNĐ</td>
                                            <td>
                                                @switch (order.Status.ToLower())
                                                {
                                                    case "pending":
                                                        <span class="badge bg-secondary">Chờ xác nhận</span>
                                                        break;
                                                    case "confirmed":
                                                        <span class="badge bg-primary">Đã xác nhận</span>
                                                        break;
                                                    case "shipping":
                                                        <span class="badge bg-info">Đang giao hàng</span>
                                                        break;
                                                    case "delivered":
                                                        <span class="badge bg-success">Đã giao hàng</span>
                                                        break;
                                                    case "cancelled":
                                                        <span class="badge bg-danger">Đã hủy</span>
                                                        break;
                                                    default:
                                                        <span class="badge bg-secondary">@order.Status</span>
                                                        break;
                                                }
                                            </td>
                                            <td>
                                                <a asp-action="OrderDetails" asp-route-id="@order.Id" class="btn btn-sm btn-primary">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="text-end mt-3">
                            <a asp-action="Orders" class="btn btn-outline-primary">Xem tất cả đơn hàng</a>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Chưa có đơn hàng nào</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div> 