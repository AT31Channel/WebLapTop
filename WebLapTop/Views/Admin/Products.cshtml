@model WebLapTop.Models.ViewModels.AdminProductsViewModel

@{
    ViewData["Title"] = "Quản lý sản phẩm";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0 text-dark">
            <i class="fas fa-laptop me-2"></i>Danh sách sản phẩm (@Model.TotalItems)
        </h4>
        <a asp-action="CreateProduct" class="btn btn-primary">
            <i class="fas fa-plus me-2"></i>Thêm sản phẩm mới
        </a>
    </div>

    <div class="card card-cyber">
        <div class="card-body bg-white">
            @if (!Model.Products.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-box-open fa-4x mb-3 text-muted"></i>
                    <h4 class="text-dark">Chưa có sản phẩm nào</h4>
                    <p class="text-muted">Hãy thêm sản phẩm mới để bắt đầu</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr class="text-dark">
                                <th>Mã</th>
                                <th>Ảnh</th>
                                <th>Tên sản phẩm</th>
                                <th>Danh mục</th>
                                <th>Giá</th>
                                <th>Giảm giá</th>
                                <th>Tồn kho</th>
                                <th>Trạng thái</th>
                                <th class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model.Products)
                            {
                                <tr class="text-dark">
                                    <td>@product.Id</td>
                                    <td>
                                        <img src="@product.ImageUrl" alt="@product.Name" style="width: 50px; height: 50px; object-fit: cover;" />
                                    </td>
                                    <td>
                                        <div>@product.Name</div>
                                        <small class="text-muted">@(product.Description != null ? product.Description.Substring(0, Math.Min(50, product.Description.Length)) + "..." : "")</small>
                                    </td>
                                    <td>@(product.Category?.Name ?? "Chưa phân loại")</td>
                                    <td>@String.Format("{0:N0}", product.Price) ₫</td>
                                    <td>
                                        @if (product.DiscountPrice > 0)
                                        {
                                            <span class="badge bg-danger text-white">-@((int)((product.Price - product.DiscountPrice) / product.Price * 100))%</span>
                                            <div class="small text-danger fw-bold mt-1">@String.Format("{0:N0}", product.DiscountPrice) ₫</div>
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (product.Stock <= 5)
                                        {
                                            <span class="badge bg-danger text-white">@product.Stock</span>
                                        }
                                        else if (product.Stock <= 10)
                                        {
                                            <span class="badge bg-warning text-dark">@product.Stock</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success text-white">@product.Stock</span>
                                        }
                                    </td>
                                    <td>
                                        @if (product.IsAvailable)
                                        {
                                            <span class="badge bg-success text-white">Đang bán</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary text-white">Ngừng bán</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group">
                                            <a asp-action="EditProduct" asp-route-id="@product.Id" 
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <button type="button" class="btn btn-sm btn-outline-danger"
                                                    onclick="confirmDelete(@product.Id, '@product.Name')">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.TotalPages > 1)
                {
                    <div class="d-flex justify-content-center mt-4">
                        <nav>
                            <ul class="pagination">
                                @if (Model.CurrentPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" asp-action="Products" asp-route-page="@(Model.CurrentPage - 1)">
                                            <i class="fas fa-chevron-left"></i>
                                        </a>
                                    </li>
                                }

                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" asp-action="Products" asp-route-page="@i">@i</a>
                                    </li>
                                }

                                @if (Model.CurrentPage < Model.TotalPages)
                                {
                                    <li class="page-item">
                                        <a class="page-link" asp-action="Products" asp-route-page="@(Model.CurrentPage + 1)">
                                            <i class="fas fa-chevron-right"></i>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id, name) {
            Swal.fire({
                title: 'Xác nhận xóa?',
                text: `Bạn có chắc chắn muốn xóa sản phẩm "${name}"?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Xóa',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = `/Admin/DeleteProduct/${id}`;
                }
            });
        }
    </script>
} 