@using System.Linq
@model WebLapTop.Models.ViewModels.UserDetailViewModel
@{
    ViewData["Title"] = "Chi tiết người dùng";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Chi tiết người dùng</h2>
        <a asp-action="Users" class="btn btn-secondary">
            <i class="bi bi-arrow-left me-2"></i>Quay lại
        </a>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0">Thông tin cá nhân</h5>
                </div>
                <div class="card-body">
                    <div class="text-center mb-4">
                        <div class="avatar-placeholder bg-light rounded-circle mx-auto mb-3" style="width: 120px; height: 120px; display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-person-circle" style="font-size: 4rem;"></i>
                        </div>
                        <h4>@Model.UserName</h4>
                        @foreach (var role in Model.Roles)
                        {
                            @if (role == "Admin")
                            {
                                <span class="badge bg-danger">@role</span>
                            }
                            else
                            {
                                <span class="badge bg-primary">@role</span>
                            }
                        }
                    </div>

                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">
                            <div class="d-flex justify-content-between">
                                <strong>ID:</strong>
                                <span class="text-truncate" style="max-width: 200px;">@Model.Id</span>
                            </div>
                        </li>
                        <li class="list-group-item">
                            <div class="d-flex justify-content-between">
                                <strong>Họ tên:</strong>
                                <span>@(string.IsNullOrEmpty(Model.FullName) ? "-" : Model.FullName)</span>
                            </div>
                        </li>
                        <li class="list-group-item">
                            <div class="d-flex justify-content-between">
                                <strong>Email:</strong>
                                <span>@Model.Email</span>
                            </div>
                        </li>
                        <li class="list-group-item">
                            <div class="d-flex justify-content-between">
                                <strong>Số điện thoại:</strong>
                                <span>@(string.IsNullOrEmpty(Model.PhoneNumber) ? "-" : Model.PhoneNumber)</span>
                            </div>
                        </li>
                        <li class="list-group-item">
                            <div class="d-flex justify-content-between">
                                <strong>Địa chỉ:</strong>
                                <span>@(string.IsNullOrEmpty(Model.Address) ? "-" : Model.Address)</span>
                            </div>
                        </li>
                    </ul>

                    <div class="mt-3">
                        <form asp-action="ToggleAdminRole" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn thay đổi vai trò của người dùng này?');">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-outline-danger w-100">
                                @if (Model.Roles.Contains("Admin"))
                                {
                                    <i class="bi bi-arrow-down-circle me-2"></i> <span>Hủy quyền Admin</span>
                                }
                                else
                                {
                                    <i class="bi bi-arrow-up-circle me-2"></i> <span>Cấp quyền Admin</span>
                                }
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0">Lịch sử đơn hàng</h5>
                </div>
                <div class="card-body">
                    @if (Model.Orders.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Mã đơn</th>
                                        <th>Ngày đặt</th>
                                        <th>Tổng tiền</th>
                                        <th>Trạng thái</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in Model.Orders)
                                    {
                                        <tr>
                                            <td>#@order.Id.ToString("D6")</td>
                                            <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>@order.TotalAmount.ToString("N0") VNĐ</td>
                                            <td>
                                                @switch (order.Status.ToLower())
                                                {
                                                    case "pending":
                                                        <span class="badge bg-secondary">Chờ xác nhận</span>
                                                        break;
                                                    case "confirmed":
                                                        <span class="badge bg-primary">Đã xác nhận</span>
                                                        break;
                                                    case "shipping":
                                                        <span class="badge bg-info">Đang giao hàng</span>
                                                        break;
                                                    case "delivered":
                                                        <span class="badge bg-success">Đã giao hàng</span>
                                                        break;
                                                    case "cancelled":
                                                        <span class="badge bg-danger">Đã hủy</span>
                                                        break;
                                                    default:
                                                        <span class="badge bg-secondary">@order.Status</span>
                                                        break;
                                                }
                                            </td>
                                            <td>
                                                <a asp-action="OrderDetails" asp-route-id="@order.Id" class="btn btn-sm btn-primary">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle me-2"></i>
                            Người dùng này chưa có đơn hàng nào.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div> 