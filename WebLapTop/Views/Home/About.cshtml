@{
    ViewData["Title"] = "Giới thiệu";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-6 mb-4">
            <h2 class="display-6 fw-bold mb-4">CHẤT LƯỢNG TẠO NÊN THƯƠNG HIỆU</h2>
            <p class="lead text-muted">
                LapTop NPD là đơn vị chuyên cung cấp các dòng laptop chính hãng hàng đầu tại Việt Nam, 
                với hơn 10 năm kinh nghiệm trong lĩnh vực công nghệ.
            </p>
            <div class="mt-4">
                <h5 class="fw-bold mb-3">Tại sao chọn chúng tôi?</h5>
                <ul class="list-unstyled">
                    <li class="mb-3">
                        <i class="fas fa-check-circle text-primary me-2"></i>
                        Sản phẩm chính hãng 100%
                    </li>
                    <li class="mb-3">
                        <i class="fas fa-check-circle text-primary me-2"></i>
                        Giá cả cạnh tranh nhất thị trường
                    </li>
                    <li class="mb-3">
                        <i class="fas fa-check-circle text-primary me-2"></i>
                        Đội ngũ tư vấn chuyên nghiệp
                    </li>
                    <li class="mb-3">
                        <i class="fas fa-check-circle text-primary me-2"></i>
                        Chế độ bảo hành tốt nhất
                    </li>
                </ul>
            </div>
        </div>
        <div class="col-lg-6">
            <img src="~/images/about-us.jpg" alt="Về chúng tôi" class="img-fluid rounded shadow-lg">
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-md-4 mb-4">
            <div class="text-center">
                <i class="fas fa-users fa-3x text-primary mb-3"></i>
                <h4 class="fw-bold">Đội ngũ nhân viên</h4>
                <p class="text-muted">
                    Đội ngũ nhân viên chuyên nghiệp, được đào tạo bài bản về kỹ thuật và chăm sóc khách hàng.
                </p>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="text-center">
                <i class="fas fa-shield-alt fa-3x text-primary mb-3"></i>
                <h4 class="fw-bold">Cam kết chất lượng</h4>
                <p class="text-muted">
                    Chúng tôi cam kết cung cấp sản phẩm chất lượng cao, chính hãng với giá tốt nhất thị trường.
                </p>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="text-center">
                <i class="fas fa-headset fa-3x text-primary mb-3"></i>
                <h4 class="fw-bold">Hỗ trợ 24/7</h4>
                <p class="text-muted">
                    Đội ngũ hỗ trợ kỹ thuật và chăm sóc khách hàng luôn sẵn sàng phục vụ 24/7.
                </p>
            </div>
        </div>
    </div>
</div>
