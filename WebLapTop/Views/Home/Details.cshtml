@using System.Linq
@using WebLapTop.Models.Entities
@model WebLapTop.Models.Entities.Product

@{
    ViewData["Title"] = Model.Name;
}

<div class="container-fluid py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="@Url.Action("Index")" class="text-decoration-none" style="color: var(--cyber-blue);">
                    <i class="fas fa-home me-1"></i> Trang chủ
                </a>
            </li>
            <li class="breadcrumb-item">
                <a href="@Url.Action("Index", new { category = Model.Category?.Name })" class="text-decoration-none" style="color: var(--cyber-blue);">
                    @(Model.Category?.Name ?? "Chưa phân loại")
                </a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-lg-9">
            <div class="card mb-4 border-0" style="background: var(--cyber-bg-light);">
                <div class="card-body">
                    <div class="row">
                        <!-- Product Image -->
                        <div class="col-lg-6 col-md-6 mb-4">
                            <div class="product-image-container">
                                @{
                                    var randomParam = DateTime.Now.Ticks;
                                    var imageUrl = Model.ImageUrl + "?v=" + randomParam;
                                }
                                <img src="@imageUrl" alt="@Model.Name" class="img-fluid rounded" style="width: 100%; height: 300px; object-fit: contain; box-shadow: 0 5px 20px rgba(0, 0, 0, 0.3); border: 1px solid rgba(0, 243, 255, 0.2);">
                            </div>
                            @if (Model.Name.Contains("Acer Nitro"))
                            {
                                <div class="mt-3 p-3" style="background: rgba(0, 243, 255, 0.05); border: 1px solid rgba(0, 243, 255, 0.2); border-radius: 8px;">
                                    <h5 class="text-white"><i class="fas fa-info-circle me-2" style="color: var(--cyber-blue);"></i>Giới thiệu</h5>
                                    <p>Acer Nitro 5 là laptop gaming mạnh mẽ với hiệu năng vượt trội. Thiết kế hiện đại với bàn phím RGB, làm mát hiệu quả và màn hình chất lượng cao.</p>
                                </div>
                            }
                            @if (Model.Name.Contains("Dell Vostro"))
                            {
                                <div class="mt-3 p-3" style="background: rgba(0, 243, 255, 0.05); border: 1px solid rgba(0, 243, 255, 0.2); border-radius: 8px;">
                                    <h5 class="text-white"><i class="fas fa-info-circle me-2" style="color: var(--cyber-blue);"></i>Giới thiệu</h5>
                                    <p>Dell Vostro 3520 là laptop doanh nhân với thiết kế thanh lịch, chuyên nghiệp. Hiệu năng ổn định cho công việc văn phòng, thời lượng pin tốt và độ bền cao phù hợp di chuyển thường xuyên.</p>
                                </div>
                            }
                            @if (Model.Name.Contains("MSI Creator"))
                            {
                                <div class="mt-3 p-3" style="background: rgba(0, 243, 255, 0.05); border: 1px solid rgba(0, 243, 255, 0.2); border-radius: 8px;">
                                    <h5 class="text-white"><i class="fas fa-info-circle me-2" style="color: var(--cyber-blue);"></i>Giới thiệu</h5>
                                    <p>MSI Creator Z16 là laptop cao cấp dành cho người sáng tạo nội dung với màn hình 16 inch tỷ lệ 16:10 chuẩn màu DCI-P3 100%. Hiệu năng mạnh mẽ với CPU Intel Core i7 thế hệ 12, card đồ họa RTX 3060 và thiết kế vỏ nhôm CNC sang trọng.</p>
                                </div>
                            }
                        </div>

                        <!-- Thông tin sản phẩm -->
                        <div class="col-md-6">
                            <div class="product-info">
                                <h4 class="product-title mb-4">@Model.Name</h4>

                                <div class="mb-4">
                                    @if (Model.DiscountPrice.HasValue)
                                    {
                                        <div class="d-flex align-items-center gap-2 mb-2">
                                            <div class="text-decoration-line-through text-muted" style="font-size: 1.1rem;">
                                                @Model.Price.ToString("N0") ₫
                                            </div>
                                            <span class="badge bg-danger">
                                                <i class="fas fa-tag me-1"></i>
                                                Giảm @(((Model.Price - Model.DiscountPrice.Value) / Model.Price * 100).ToString("0"))%
                                            </span>
                                        </div>
                                        <div class="product-price" style="font-size: 1.8rem; color: var(--cyber-pink); font-weight: 700;">
                                            @Model.DiscountPrice.Value.ToString("N0") ₫
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="product-price" style="font-size: 1.8rem; color: var(--cyber-blue); font-weight: 700;">
                                            @Model.Price.ToString("N0") ₫
                                        </div>
                                    }
                                </div>

                                <div class="mb-4">
                                    <h5 class="mb-3">Mô tả sản phẩm:</h5>
                                    <p class="product-description">@Model.Description</p>
                                </div>

                                @if (ViewBag.Specifications != null)
                                {
                                    <div class="mb-4">
                                        <h5 class="mb-3">Thông số kỹ thuật:</h5>
                                        <div class="table-responsive">
                                            <table class="table table-borderless" style="color: #e6f0ff; font-size: 0.95rem;">
                                                <tbody>
                                                    @foreach (var spec in ViewBag.Specifications)
                                                    {
                                                        <tr>
                                                            <td style="width: 140px; font-weight: 600;">@spec.Key:</td>
                                                            <td>@spec.Value</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                }

                                <div class="mb-4">
                                    <h5 class="mb-3" style="color: var(--cyber-blue);">Thông tin thêm:</h5>
                                    <ul class="list-group list-group-flush" style="background: transparent;">
                                        <li class="list-group-item d-flex justify-content-between align-items-center" style="background: rgba(0, 243, 255, 0.05); border-color: rgba(0, 243, 255, 0.2);">
                                            <span>Danh mục</span>
                                            <span class="badge" style="background: var(--cyber-bg); color: var(--cyber-blue);">@(Model.Category?.Name ?? "Chưa phân loại")</span>
                                        </li>
                                        <li class="list-group-item d-flex justify-content-between align-items-center" style="background: rgba(0, 243, 255, 0.05); border-color: rgba(0, 243, 255, 0.2);">
                                            <span>Tình trạng</span>
                                            @if (Model.IsAvailable)
                                            {
                                                <span class="badge bg-success">Còn hàng</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Hết hàng</span>
                                            }
                                        </li>
                                    </ul>
                                </div>

                                <div class="mt-4">
                                    <h5 class="mb-3">Số lượng:</h5>
                                    @if (Model.IsAvailable)
                                    {
                                        @if (User.Identity?.IsAuthenticated == true)
                                        {
                                            @if (TempData["Success"] != null)
                                            {
                                                <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
                                                    <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                                                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                                </div>
                                            }

                                            <div class="input-group" style="width: 150px;">
                                                <button class="btn btn-outline-secondary" type="button" onclick="decreaseQuantity()">-</button>
                                                <input type="number" class="form-control text-center" id="quantity" value="1" min="1" max="@Model.Stock">
                                                <button class="btn btn-outline-secondary" type="button" onclick="increaseQuantity()">+</button>
                                            </div>
                                            <div class="mt-3">
                                                <button class="btn btn-primary me-2" onclick="addToCart()">
                                                    <i class="fas fa-shopping-cart"></i> Thêm vào giỏ
                                                </button>
                                                <button class="btn btn-success" onclick="buyNow()">
                                                    <i class="fas fa-bolt"></i> Mua ngay
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="alert alert-info">
                                                <i class="fas fa-info-circle me-2"></i> Vui lòng 
                                                <a href="@Url.Action("Login", "Account", new { returnUrl = Url.Action("Details", "Home", new { id = Model.Id }) })" class="login-register-link">đăng nhập</a> 
                                                để thêm sản phẩm vào giỏ hàng hoặc 
                                                <a href="@Url.Action("Register", "Account")" class="login-register-link">đăng ký</a> 
                                                nếu bạn chưa có tài khoản.
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="alert" style="background: rgba(255, 0, 0, 0.1); border: 1px solid rgba(255, 0, 0, 0.3); color: #ff6b6b;">
                                            <i class="fas fa-exclamation-triangle me-2"></i> Sản phẩm tạm hết hàng
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-3">
            <div class="sidebar mb-4">
                <h4 class="sidebar-title">Thông tin bảo hành</h4>
                <ul class="list-unstyled ps-2">
                    <li class="mb-2"><i class="fas fa-check-circle me-2" style="color: var(--cyber-blue);"></i> Bảo hành chính hãng 24 tháng</li>
                    <li class="mb-2"><i class="fas fa-check-circle me-2" style="color: var(--cyber-blue);"></i> Đổi mới trong 15 ngày đầu</li>
                    <li class="mb-2"><i class="fas fa-check-circle me-2" style="color: var(--cyber-blue);"></i> Hỗ trợ kỹ thuật 24/7</li>
                </ul>
            </div>

            <div class="sidebar mb-4">
                <h4 class="sidebar-title">Vận chuyển</h4>
                <ul class="list-unstyled ps-2">
                    <li class="mb-2"><i class="fas fa-truck me-2" style="color: var(--cyber-blue);"></i> Giao hàng toàn quốc</li>
                    <li class="mb-2"><i class="fas fa-box me-2" style="color: var(--cyber-blue);"></i> Đóng gói cẩn thận</li>
                    <li class="mb-2"><i class="fas fa-shipping-fast me-2" style="color: var(--cyber-blue);"></i> Vận chuyển nhanh chóng</li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Related Products Section -->
    @if (ViewBag.RelatedProducts != null && ((IEnumerable<Product>)ViewBag.RelatedProducts).Any())
    {
        <div class="related-products mt-4">
            <h4 class="mb-3">Sản phẩm liên quan</h4>
            <div class="row">
                @foreach (var relatedProduct in (IEnumerable<Product>)ViewBag.RelatedProducts)
                {
                    <div class="col-md-3 mb-4">
                        <div class="card h-100" style="background: var(--cyber-bg-light); border: 1px solid rgba(0, 243, 255, 0.2);">
                            <img src="@relatedProduct.ImageUrl" class="card-img-top" alt="@relatedProduct.Name" style="height: 200px; object-fit: contain; padding: 1rem;">
                            <div class="card-body">
                                <h5 class="card-title" style="font-size: 1rem;">@relatedProduct.Name</h5>
                                <p class="card-text" style="color: var(--cyber-blue);">@relatedProduct.Price.ToString("N0") ₫</p>
                                <a href="@Url.Action("Details", new { id = relatedProduct.Id })" class="btn btn-cyber btn-sm">
                                    <i class="fas fa-info-circle me-1"></i> Chi tiết
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function decreaseQuantity() {
            var quantityInput = document.getElementById('quantity');
            var currentValue = parseInt(quantityInput.value);
            if (currentValue > 1) {
                quantityInput.value = currentValue - 1;
            }
        }

        function increaseQuantity() {
            var quantityInput = document.getElementById('quantity');
            var currentValue = parseInt(quantityInput.value);
            var maxStock = parseInt(quantityInput.max);
            if (currentValue < maxStock) {
                quantityInput.value = currentValue + 1;
            }
        }

        function addToCart() {
            var quantity = document.getElementById('quantity').value;
            var productId = @Model.Id;
            
            fetch('/Cart/AddToCart', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    productId: productId,
                    quantity: quantity
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showAlert('success', 'Đã thêm sản phẩm vào giỏ hàng');
                    updateCartCount(data.cartCount);
                } else {
                    showAlert('danger', data.message || 'Có lỗi xảy ra');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showAlert('danger', 'Có lỗi xảy ra khi thêm vào giỏ hàng');
            });
        }

        function buyNow() {
            var quantity = document.getElementById('quantity').value;
            var productId = @Model.Id;
            
            fetch('/Cart/AddToCart', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    productId: productId,
                    quantity: quantity
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    window.location.href = '/Cart';
                } else {
                    showAlert('danger', data.message || 'Có lỗi xảy ra');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showAlert('danger', 'Có lỗi xảy ra khi thêm vào giỏ hàng');
            });
        }

        function showAlert(type, message) {
            var alertDiv = document.createElement('div');
            alertDiv.className = `alert alert-${type} alert-dismissible fade show`;
            alertDiv.role = 'alert';
            alertDiv.innerHTML = `
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            `;
            document.querySelector('.container-fluid').prepend(alertDiv);
            setTimeout(() => alertDiv.remove(), 5000);
        }

        function updateCartCount(count) {
            var cartCountElement = document.querySelector('.cart-count');
            if (cartCountElement) {
                cartCountElement.textContent = count;
            }
        }
    </script>

    <style>
        .btn-outline-secondary {
            color: #ffffff;
            border-color: #58a6ff;
            background: #21262d;
        }

        .btn-outline-secondary:hover {
            background-color: #30363d;
            border-color: #58a6ff;
            color: #ffffff;
        }

        .btn-primary {
            background-color: #1f6feb;
            border-color: #388bfd;
            color: #ffffff;
            font-weight: 500;
        }

        .btn-primary:hover {
            background-color: #388bfd;
            border-color: #58a6ff;
            color: #ffffff;
        }

        .btn-success {
            background-color: #238636;
            border-color: #2ea043;
            color: #ffffff;
            font-weight: 500;
        }

        .btn-success:hover {
            background-color: #2ea043;
            border-color: #3fb950;
            color: #ffffff;
        }

        .form-control {
            background-color: #0d1117;
            border-color: #30363d;
            color: #ffffff;
        }

        .form-control:focus {
            background-color: #161b22;
            border-color: #1f6feb;
            color: #ffffff;
            box-shadow: 0 0 0 0.25rem rgba(56, 139, 253, 0.25);
        }

        /* Cập nhật giao diện cho nút - và + */
        .input-group .btn {
            z-index: 0;
        }
    </style>
}
