@{
    ViewData["Title"] = "Liên hệ";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-6 mb-4">
            <h2 class="display-6 fw-bold mb-4">Liên hệ với chúng tôi</h2>
            <p class="lead text-muted mb-4">
                Hãy để lại thông tin, chúng tôi sẽ liên hệ với bạn sớm nhất có thể.
            </p>

            <form>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="form-floating">
                            <input type="text" class="form-control" id="name" placeholder="Họ và tên">
                            <label for="name">Họ và tên</label>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="form-floating">
                            <input type="email" class="form-control" id="email" placeholder="Email">
                            <label for="email">Email</label>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="form-floating">
                        <input type="tel" class="form-control" id="phone" placeholder="Số điện thoại">
                        <label for="phone">Số điện thoại</label>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="form-floating">
                        <textarea class="form-control" id="message" style="height: 150px" placeholder="Nội dung"></textarea>
                        <label for="message">Nội dung</label>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="fas fa-paper-plane me-2"></i>Gửi tin nhắn
                </button>
            </form>
        </div>

        <div class="col-lg-6">
            <div class="card border-0 shadow-lg h-100">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-4">Thông tin liên hệ</h4>
                    
                    <div class="d-flex mb-4">
                        <div class="flex-shrink-0">
                            <i class="fas fa-map-marker-alt fa-2x text-primary"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h5 class="fw-bold">Địa chỉ</h5>
                            <p class="text-muted mb-0">123 Đường ABC, Quận XYZ<br>TP. Hồ Chí Minh</p>
                        </div>
                    </div>

                    <div class="d-flex mb-4">
                        <div class="flex-shrink-0">
                            <i class="fas fa-phone fa-2x text-primary"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h5 class="fw-bold">Điện thoại</h5>
                            <p class="text-muted mb-0">
                                Hotline: 0123 456 789<br>
                                Hỗ trợ kỹ thuật: 0987 654 321
                            </p>
                        </div>
                    </div>

                    <div class="d-flex mb-4">
                        <div class="flex-shrink-0">
                            <i class="fas fa-envelope fa-2x text-primary"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h5 class="fw-bold">Email</h5>
                            <p class="text-muted mb-0">
                                contact@weblaptop.com<br>
                                support@weblaptop.com
                            </p>
                        </div>
                    </div>

                    <div class="d-flex">
                        <div class="flex-shrink-0">
                            <i class="fas fa-clock fa-2x text-primary"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h5 class="fw-bold">Giờ làm việc</h5>
                            <p class="text-muted mb-0">
                                Thứ 2 - Thứ 7: 8:00 - 21:00<br>
                                Chủ nhật: 8:00 - 17:00
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
