@model IEnumerable<WebLapTop.Models.Entities.Order>

@{
    ViewData["Title"] = "Lịch sử đơn hàng";
}

<div class="container-fluid py-4">
    @Html.AntiForgeryToken()
    <div class="mb-4">
        <h3 style="color: var(--cyber-blue);">
            <i class="fas fa-history me-2"></i>Lịch sử đơn hàng
        </h3>
        <p class="text-muted">Quản lý và theo dõi tất cả đơn hàng của bạn</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="fas fa-shopping-bag fa-4x mb-3 text-muted"></i>
            <h4>Bạn chưa có đơn hàng nào</h4>
            <p class="text-muted">Hãy mua sắm để có những trải nghiệm tuyệt vời với WebLapTop</p>
            <a href="@Url.Action("Index", "Home")" class="btn btn-primary">
                <i class="fas fa-shopping-cart me-2"></i>Mua sắm ngay
            </a>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Mã đơn hàng</th>
                                <th>Ngày đặt</th>
                                <th>Tổng tiền</th>
                                <th>Trạng thái</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.OrderByDescending(o => o.OrderDate))
                            {
                                <tr>
                                    <td><strong>#@order.Id</strong></td>
                                    <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td><strong class="text-danger">@order.TotalAmount.ToString("#,##0") ₫</strong></td>
                                    <td>
                                        @switch (order.Status.ToLower())
                                        {
                                            case "pending":
                                                <span class="badge bg-warning text-dark">Chờ xử lý</span>
                                                break;
                                            case "confirmed":
                                                <span class="badge bg-primary">Đã xác nhận</span>
                                                break;
                                            case "shipping":
                                                <span class="badge bg-info">Đang giao</span>
                                                break;
                                            case "delivered":
                                                <span class="badge bg-success">Đã giao</span>
                                                break;
                                            case "cancelled":
                                                <span class="badge bg-danger">Đã hủy</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary">@order.Status</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        <a href="@Url.Action("OrderDetails", "Cart", new { id = order.Id })" 
                                           class="btn btn-sm btn-info">
                                            <i class="fas fa-eye me-1"></i>Chi tiết
                                        </a>
                                        @if (order.Status.ToLower() == "pending")
                                        {
                                            <button class="btn btn-sm btn-danger ms-1" 
                                                    onclick="confirmCancelOrder('@order.Id')">
                                                <i class="fas fa-times me-1"></i>Hủy
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function confirmCancelOrder(orderId) {
            if (confirm('Bạn có chắc chắn muốn hủy đơn hàng này không?')) {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                
                // Disable all cancel buttons to prevent double submission
                const cancelButtons = document.querySelectorAll('.btn-danger');
                cancelButtons.forEach(btn => btn.disabled = true);
                
                // Show loading state
                const targetButton = document.querySelector(`button[onclick="confirmCancelOrder('${orderId}')"]`);
                const originalContent = targetButton.innerHTML;
                targetButton.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Đang hủy...';
                
                $.ajax({
                    url: '@Url.Action("CancelOrder", "Cart")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        orderId: parseInt(orderId),
                        reason: 'Khách hàng yêu cầu hủy đơn hàng'
                    }),
                    headers: {
                        'RequestVerificationToken': token
                    },
                    success: function(response) {
                        if (response.success) {
                            showAlert('success', response.message || 'Đã hủy đơn hàng thành công');
                            // Reload page after 2 seconds
                            setTimeout(() => location.reload(), 2000);
                        } else {
                            showAlert('danger', response.message || 'Không thể hủy đơn hàng');
                            // Re-enable buttons and restore original state
                            cancelButtons.forEach(btn => btn.disabled = false);
                            targetButton.innerHTML = originalContent;
                        }
                    },
                    error: function(xhr) {
                        let errorMessage = 'Có lỗi xảy ra khi hủy đơn hàng';
                        try {
                            const response = JSON.parse(xhr.responseText);
                            if (response.message) {
                                errorMessage = response.message;
                            }
                        } catch (e) {
                            console.error('Error parsing error response:', e);
                        }
                        showAlert('danger', errorMessage);
                        // Re-enable buttons and restore original state
                        cancelButtons.forEach(btn => btn.disabled = false);
                        targetButton.innerHTML = originalContent;
                    }
                });
            }
        }

        function showAlert(type, message) {
            const alertHtml = `
                <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                    <i class="fas fa-${type === 'success' ? 'check' : 'exclamation'}-circle me-2"></i>${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            `;
            // Remove any existing alerts
            document.querySelectorAll('.alert').forEach(alert => alert.remove());
            // Add new alert at the top of the container
            document.querySelector('.container-fluid').insertAdjacentHTML('afterbegin', alertHtml);
        }
    </script>
} 