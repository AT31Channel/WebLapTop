@model WebLapTop.Models.Entities.Order

@{
    ViewData["Title"] = "Chi tiết đơn hàng #" + Model.Id;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0" style="color: var(--cyber-blue);">Chi tiết đơn hàng #@Model.Id</h3>
        <a href="@Url.Action("OrderHistory")" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Quay lại lịch sử đơn hàng
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Timeline theo dõi trạng thái đơn hàng -->
    <div class="card card-cyber mb-4">
        <div class="card-header">
            <h4 class="mb-0">
                <i class="fas fa-shipping-fast me-2"></i>Trạng thái đơn hàng
            </h4>
        </div>
        <div class="card-body">
            <div class="order-timeline">
                @{
                    var currentStatus = Model.Status;
                    var statusList = new[] { "Pending", "Confirmed", "Shipping", "Delivered" };
                    var statusNames = new Dictionary<string, string>
                    {
                        { "Pending", "Chờ xử lý" },
                        { "Confirmed", "Đã xác nhận" },
                        { "Shipping", "Đang giao hàng" },
                        { "Delivered", "Đã giao hàng" },
                        { "Cancelled", "Đã hủy" }
                    };
                    
                    var currentStatusIndex = Array.IndexOf(statusList, currentStatus);
                    
                    if (currentStatus == "Cancelled")
                    {
                        <div class="alert alert-danger text-center">
                            <i class="fas fa-times-circle fa-2x mb-3"></i>
                            <h5>Đơn hàng đã bị hủy</h5>
                            <p class="mb-0">Đơn hàng này đã bị hủy và không thể tiếp tục xử lý.</p>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex justify-content-between position-relative order-progress-container">
                            <div class="progress position-absolute" style="width: 100%; height: 4px; top: 25px; z-index: 0;">
                                <div class="progress-bar bg-success" role="progressbar" style="width: @(currentStatusIndex >= 0 ? (currentStatusIndex * 100 / (statusList.Length - 1)) : 0)%;" aria-valuenow="@(currentStatusIndex >= 0 ? (currentStatusIndex * 100 / (statusList.Length - 1)) : 0)" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>

                            @for (int i = 0; i < statusList.Length; i++)
                            {
                                var status = statusList[i];
                                var isActive = currentStatusIndex >= i;
                                
                                <div class="order-status-item text-center" style="z-index: 1;">
                                    <div class="status-circle @(isActive ? "active" : "")" data-bs-toggle="tooltip" data-bs-placement="top" title="@(statusNames.ContainsKey(status) ? statusNames[status] : status)">
                                        @if (isActive)
                                        {
                                            <i class="fas fa-check"></i>
                                        }
                                    </div>
                                    <div class="status-label mt-3 @(isActive ? "fw-bold" : "")">
                                        @(statusNames.ContainsKey(status) ? statusNames[status] : status)
                                    </div>
                                </div>
                            }
                        </div>
                        
                        <div class="text-center mt-4">
                            <p class="mb-1">
                                <i class="fas fa-info-circle me-2"></i>
                                Trạng thái hiện tại: <span class="fw-bold">@(statusNames.ContainsKey(currentStatus) ? statusNames[currentStatus] : currentStatus)</span>
                            </p>
                            <p class="text-muted small">Cập nhật lần cuối: @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                    }
                }
                
                @if (Model.Status == "Pending")
                {
                    <div class="text-center mt-3">
                        <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#cancelOrderModal">
                            <i class="fas fa-times-circle me-2"></i>Hủy đơn hàng
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Thông tin đơn hàng -->
        <div class="col-lg-6 mb-4">
            <div class="card card-cyber h-100">
                <div class="card-header">
                    <h4 class="mb-0">
                        <i class="fas fa-info-circle me-2"></i>Thông tin đơn hàng
                    </h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Mã đơn hàng:</strong> #@Model.Id</p>
                            <p><strong>Ngày đặt hàng:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                            <p><strong>Phương thức thanh toán:</strong> @Model.PaymentMethod</p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Tổng tiền:</strong> <span class="text-danger fw-bold">@Model.TotalAmount.ToString("#,##0") ₫</span></p>
                            <p><strong>Trạng thái:</strong> 
                                @switch (Model.Status)
                                {
                                    case "Pending":
                                        <span class="badge bg-warning text-dark">Chờ xử lý</span>
                                        break;
                                    case "Confirmed":
                                        <span class="badge bg-primary">Đã xác nhận</span>
                                        break;
                                    case "Shipping":
                                        <span class="badge bg-info">Đang giao</span>
                                        break;
                                    case "Delivered":
                                        <span class="badge bg-success">Đã giao</span>
                                        break;
                                    case "Cancelled":
                                        <span class="badge bg-danger">Đã hủy</span>
                                        break;
                                    default:
                                        <span class="badge bg-secondary">@Model.Status</span>
                                        break;
                                }
                            </p>
                            <p><strong>Ghi chú:</strong> @(string.IsNullOrEmpty(Model.Note) ? "Không có" : Model.Note)</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Thông tin giao hàng -->
        <div class="col-lg-6 mb-4">
            <div class="card card-cyber h-100">
                <div class="card-header">
                    <h4 class="mb-0">
                        <i class="fas fa-shipping-fast me-2"></i>Thông tin giao hàng
                    </h4>
                </div>
                <div class="card-body">
                    <p><strong>Người nhận:</strong> @Model.FullName</p>
                    <p><strong>Số điện thoại:</strong> @Model.PhoneNumber</p>
                    <p><strong>Email:</strong> @Model.Email</p>
                    <p><strong>Địa chỉ giao hàng:</strong> @Model.ShippingAddress</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Chi tiết đơn hàng -->
    <div class="card card-cyber">
        <div class="card-header">
            <h4 class="mb-0">
                <i class="fas fa-shopping-cart me-2"></i>Chi tiết sản phẩm
            </h4>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Sản phẩm</th>
                            <th class="text-end">Đơn giá</th>
                            <th class="text-center">Số lượng</th>
                            <th class="text-end">Thành tiền</th>
                            @if (Model.Status == "Delivered")
                            {
                                <th class="text-center">Đánh giá</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderDetails)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <img src="@item.Product?.ImageUrl" alt="@item.Product?.Name" class="img-thumbnail me-3" style="width: 60px; height: 60px; object-fit: contain;" />
                                        <div>
                                            <div class="fw-bold">@(item.Product?.Name ?? "Sản phẩm không còn tồn tại")</div>
                                            <small class="text-muted">ID: @item.ProductId</small>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-end">@item.UnitPrice.ToString("#,##0") ₫</td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-end">@((item.UnitPrice * item.Quantity).ToString("#,##0")) ₫</td>
                                @if (Model.Status == "Delivered")
                                {
                                    <td class="text-center">
                                        @if (item.IsReviewed)
                                        {
                                            <span class="badge bg-success">Đã đánh giá</span>
                                        }
                                        else
                                        {
                                            <a href="@Url.Action("Review", "Product", new { orderDetailId = item.Id })" class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-star me-1"></i>Đánh giá
                                            </a>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="@(Model.Status == "Delivered" ? "3" : "3")" class="text-end fw-bold">Tổng cộng:</td>
                            <td class="text-end fw-bold" style="color: var(--cyber-pink);">@Model.TotalAmount.ToString("#,##0") ₫</td>
                            @if (Model.Status == "Delivered")
                            {
                                <td></td>
                            }
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal xác nhận hủy đơn hàng -->
<div class="modal fade" id="cancelOrderModal" tabindex="-1" aria-labelledby="cancelOrderModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="cancelOrderModalLabel">Xác nhận hủy đơn hàng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Bạn có chắc chắn muốn hủy đơn hàng #@Model.Id?</p>
                <p class="text-danger">Lưu ý: Hành động này không thể hoàn tác.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-danger" id="confirmCancelOrder">
                    <i class="fas fa-times-circle me-2"></i>Xác nhận hủy
                </button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .order-progress-container {
            padding: 0 10%;
            margin: 30px 0;
        }
        
        .order-status-item {
            position: relative;
            width: 25%;
        }
        
        .status-circle {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background-color: #343a40;
            border: 3px solid #6c757d;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto;
            color: #fff;
            font-size: 20px;
        }
        
        .status-circle.active {
            background-color: #28a745;
            border-color: #1e7e34;
        }
        
        .status-label {
            font-size: 14px;
            color: #6c757d;
        }
        
        .status-label.fw-bold {
            color: #ffffff;
        }
    </style>
}

@section Scripts {
    <script>
        $(function () {
            // Tooltip initialization
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl)
            })
            
            // Cancel order button
            $("#confirmCancelOrder").click(function() {
                $.ajax({
                    url: '@Url.Action("CancelOrder", "Cart")',
                    type: 'POST',
                    data: { orderId: @Model.Id },
                    success: function(response) {
                        if (response.success) {
                            showAlert('success', response.message);
                            // Reload the page after a brief delay
                            setTimeout(function() {
                                window.location.reload();
                            }, 2000);
                        } else {
                            showAlert('danger', response.message);
                        }
                        $('#cancelOrderModal').modal('hide');
                    },
                    error: function() {
                        showAlert('danger', 'Có lỗi xảy ra khi hủy đơn hàng');
                        $('#cancelOrderModal').modal('hide');
                    }
                });
            });
            
            function showAlert(type, message) {
                var alertDiv = document.createElement('div');
                alertDiv.className = `alert alert-${type} alert-dismissible fade show`;
                alertDiv.role = 'alert';
                alertDiv.innerHTML = `
                    <i class="fas fa-${type === 'success' ? 'check' : 'exclamation'}-circle me-2"></i>${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                `;
                document.querySelector('.container-fluid').prepend(alertDiv);
                setTimeout(() => alertDiv.remove(), 5000);
            }
        });
    </script>
} 