@model IEnumerable<WebLapTop.Models.Entities.CustomerNotification>
@{
    ViewData["Title"] = "Thông báo của tôi";
    var unreadCount = ViewBag.UnreadCount as int? ?? 0;
}

<div class="container py-5">
    <div class="row">
        <div class="col-md-12">
            <div class="card shadow">
                <div class="card-header bg-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">Thông báo của tôi</h4>
                        @if (unreadCount > 0)
                        {
                            <button class="btn btn-sm btn-outline-primary" id="markAllAsRead">Đánh dấu tất cả đã đọc</button>
                        }
                    </div>
                </div>
                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (!Model.Any())
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-bell text-muted" style="font-size: 48px;"></i>
                            <h5 class="mt-3">Bạn chưa có thông báo nào</h5>
                            <p class="text-muted">Thông báo về đơn hàng và cập nhật khác sẽ xuất hiện ở đây</p>
                            <a href="@Url.Action("Index", "Home")" class="btn btn-primary mt-2">
                                Tiếp tục mua sắm
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="list-group">
                            @foreach (var notification in Model)
                            {
                                <a href="@Url.Action("Details", "Notification", new { id = notification.Id })"
                                   class="list-group-item list-group-item-action @(notification.IsRead ? "" : "bg-light")"
                                   data-notification-id="@notification.Id">
                                    <div class="d-flex w-100 justify-content-between align-items-center">
                                        <h5 class="mb-1">
                                            @if (!notification.IsRead)
                                            {
                                                <span class="badge bg-primary rounded-circle p-1 me-2" style="width: 8px; height: 8px;"></span>
                                            }
                                            @notification.Title
                                        </h5>
                                        <small class="text-muted">@notification.CreateDate.ToString("dd/MM/yyyy HH:mm")</small>
                                    </div>
                                    <p class="mb-1 text-truncate">@notification.Message</p>
                                    <small>
                                        @if (notification.Type == "Order")
                                        {
                                            <span class="text-primary">
                                                <i class="bi bi-box-seam me-1"></i>Đơn hàng
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-info">
                                                <i class="bi bi-info-circle me-1"></i>Thông tin
                                            </span>
                                        }
                                    </small>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Mark all notifications as read
            $("#markAllAsRead").on("click", function() {
                $.ajax({
                    url: '@Url.Action("MarkAllAsRead", "Notification")',
                    type: 'POST',
                    success: function(result) {
                        if (result.success) {
                            $('.list-group-item').removeClass('bg-light');
                            $('.badge.bg-primary.rounded-circle').hide();
                            $('#markAllAsRead').hide();
                            // Update the notification count in the layout
                            updateNotificationCount(0);
                        }
                    }
                });
            });

            // Mark a single notification as read when clicked
            $(".list-group-item").on("click", function() {
                var notificationId = $(this).data("notification-id");
                var element = $(this);
                
                if (element.hasClass('bg-light')) {
                    $.ajax({
                        url: '@Url.Action("MarkAsRead", "Notification")/' + notificationId,
                        type: 'POST',
                        success: function(result) {
                            if (result.success) {
                                element.removeClass('bg-light');
                                element.find('.badge.bg-primary.rounded-circle').hide();
                                // Update the notification count in the layout
                                var currentCount = parseInt($('#notification-count').text());
                                if (!isNaN(currentCount) && currentCount > 0) {
                                    updateNotificationCount(currentCount - 1);
                                }
                            }
                        }
                    });
                }
            });

            function updateNotificationCount(count) {
                if (count > 0) {
                    $('#notification-count').text(count).show();
                } else {
                    $('#notification-count').hide();
                }
            }
        });
    </script>
} 