@model ErrorViewModel
@{
    ViewData["Title"] = "Lỗi";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card card-cyber">
                <div class="card-body text-center">
                    <h1 class="display-4 mb-4">
                        <i class="fas fa-exclamation-triangle text-danger"></i>
                    </h1>
                    <h2 class="mb-4">@ViewBag.ErrorMessage</h2>
                    <p class="text-muted">
                        @if (Model?.ShowRequestId ?? false)
                        {
                            <small>Request ID: <code>@Model.RequestId</code></small>
                        }
                    </p>
                    <hr class="my-4">
                    <a href="/" class="btn btn-primary">
                        <i class="fas fa-home me-2"></i>Về trang chủ
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Thêm animation cho icon
        $(document).ready(function() {
            $('.fa-exclamation-triangle').addClass('animated shake');
        });
    </script>
} 