<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>
    <aspNetCore processPath="dotnet" arguments=".\WebLapTop.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
  </system.webServer>
  <appSettings>
    <!-- Tắt BrowserLink để giảm cảnh báo JavaScript -->
    <add key="vs:EnableBrowserLink" value="false" />
  </appSettings>
</configuration> 