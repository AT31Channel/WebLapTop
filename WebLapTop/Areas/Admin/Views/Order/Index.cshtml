@model IEnumerable<WebLapTop.Models.Entities.Order>
@{
    ViewData["Title"] = "Quản lý đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    
    var currentPage = ViewBag.CurrentPage;
    var totalPages = ViewBag.TotalPages;
    var searchString = ViewBag.SearchString;
    var status = ViewBag.Status;
    var orderStatuses = ViewBag.OrderStatuses;
    var newOrdersCount = ViewBag.NewOrdersCount;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                    <h6 class="m-0 font-weight-bold text-primary">
                        Quản lý đơn hàng
                        @if (newOrdersCount > 0)
                        {
                            <span class="badge bg-danger ms-2">@newOrdersCount mới</span>
                        }
                    </h6>
                </div>
                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    
                    <!-- Filter và tìm kiếm -->
                    <div class="row mb-3">
                        <div class="col-md-8">
                            <form asp-action="Index" method="get" class="d-flex">
                                <div class="input-group">
                                    <input type="text" name="searchString" value="@searchString" class="form-control" placeholder="Tìm theo mã đơn, tên, email, SĐT..."/>
                                    <select name="status" class="form-select" style="max-width: 200px;">
                                        <option value="">-- Tất cả trạng thái --</option>
                                        @foreach (var statusOption in orderStatuses)
                                        {
                                            <option value="@statusOption" @(statusOption == status ? "selected" : "")>@statusOption</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-search"></i> Tìm kiếm
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                    
                    <!-- Bảng đơn hàng -->
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Mã đơn</th>
                                    <th>Khách hàng</th>
                                    <th>Ngày đặt</th>
                                    <th>Tổng tiền</th>
                                    <th>Trạng thái</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    foreach (var order in Model)
                                    {
                                        var isNewOrder = order.Status == "Pending";
                                        <tr class="@(isNewOrder ? "table-warning" : "")">
                                            <td>
                                                #@order.Id
                                                @if (isNewOrder)
                                                {
                                                    <span class="badge bg-danger ms-1">Mới</span>
                                                }
                                            </td>
                                            <td>
                                                <strong>@order.FullName</strong><br/>
                                                <small>
                                                    <i class="fas fa-phone-alt me-1"></i>@order.PhoneNumber<br/>
                                                    <i class="fas fa-envelope me-1"></i>@order.Email
                                                </small>
                                            </td>
                                            <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td class="text-end">@order.TotalAmount.ToString("#,##0") ₫</td>
                                            <td>
                                                @switch (order.Status)
                                                {
                                                    case "Pending":
                                                        <span class="badge bg-warning text-dark">Chờ xử lý</span>
                                                        break;
                                                    case "Confirmed":
                                                        <span class="badge bg-primary">Đã xác nhận</span>
                                                        break;
                                                    case "Shipping":
                                                        <span class="badge bg-info">Đang giao</span>
                                                        break;
                                                    case "Delivered":
                                                        <span class="badge bg-success">Đã giao</span>
                                                        break;
                                                    case "Cancelled":
                                                        <span class="badge bg-danger">Đã hủy</span>
                                                        break;
                                                    default:
                                                        <span class="badge bg-secondary">@order.Status</span>
                                                        break;
                                                }
                                            </td>
                                            <td>
                                                <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-info">
                                                    <i class="fas fa-eye"></i> Chi tiết
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center">Không có đơn hàng nào</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    
                    <!-- Phân trang -->
                    @if (totalPages > 1)
                    {
                        <div class="d-flex justify-content-center mt-4">
                            <nav aria-label="Page navigation">
                                <ul class="pagination">
                                    @if (currentPage > 1)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" asp-action="Index" asp-route-page="1" asp-route-searchString="@searchString" asp-route-status="@status">
                                                <i class="fas fa-angle-double-left"></i>
                                            </a>
                                        </li>
                                        <li class="page-item">
                                            <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-searchString="@searchString" asp-route-status="@status">
                                                <i class="fas fa-angle-left"></i>
                                            </a>
                                        </li>
                                    }
                                    
                                    @{
                                        int startPage = Math.Max(1, currentPage - 2);
                                        int endPage = Math.Min(startPage + 4, totalPages);
                                        
                                        if (endPage - startPage < 4 && startPage > 1)
                                        {
                                            startPage = Math.Max(1, endPage - 4);
                                        }
                                    }
                                    
                                    @for (int i = startPage; i <= endPage; i++)
                                    {
                                        <li class="page-item @(i == currentPage ? "active" : "")">
                                            <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchString="@searchString" asp-route-status="@status">@i</a>
                                        </li>
                                    }
                                    
                                    @if (currentPage < totalPages)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-searchString="@searchString" asp-route-status="@status">
                                                <i class="fas fa-angle-right"></i>
                                            </a>
                                        </li>
                                        <li class="page-item">
                                            <a class="page-link" asp-action="Index" asp-route-page="@totalPages" asp-route-searchString="@searchString" asp-route-status="@status">
                                                <i class="fas fa-angle-double-right"></i>
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </nav>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div> 