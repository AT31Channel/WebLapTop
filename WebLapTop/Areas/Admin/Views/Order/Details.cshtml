@model WebLapTop.Models.Entities.Order
@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Chi tiết đơn hàng #@Model.Id</h1>
        <a asp-action="Index" class="btn btn-sm btn-secondary">
            <i class="fas fa-arrow-left me-1"></i>Quay lại danh sách
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <!-- Thông tin đơn hàng -->
        <div class="col-xl-4 col-md-6 mb-4">
            <div class="card shadow h-100">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Thông tin đơn hàng</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-borderless">
                            <tr>
                                <th>Mã đơn hàng:</th>
                                <td>#@Model.Id</td>
                            </tr>
                            <tr>
                                <th>Ngày đặt:</th>
                                <td>@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                            <tr>
                                <th>Trạng thái:</th>
                                <td>
                                    @switch (Model.Status)
                                    {
                                        case "Pending":
                                            <span class="badge bg-warning text-dark">Chờ xử lý</span>
                                            break;
                                        case "Confirmed":
                                            <span class="badge bg-primary">Đã xác nhận</span>
                                            break;
                                        case "Shipping":
                                            <span class="badge bg-info">Đang giao</span>
                                            break;
                                        case "Delivered":
                                            <span class="badge bg-success">Đã giao</span>
                                            break;
                                        case "Cancelled":
                                            <span class="badge bg-danger">Đã hủy</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">@Model.Status</span>
                                            break;
                                    }
                                </td>
                            </tr>
                            <tr>
                                <th>Thanh toán:</th>
                                <td>@Model.PaymentMethod</td>
                            </tr>
                            <tr>
                                <th>Tổng tiền:</th>
                                <td class="text-danger fw-bold">@Model.TotalAmount.ToString("#,##0") ₫</td>
                            </tr>
                            <tr>
                                <th>Ghi chú:</th>
                                <td>@(string.IsNullOrEmpty(Model.Note) ? "Không có" : Model.Note)</td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Thông tin khách hàng -->
        <div class="col-xl-4 col-md-6 mb-4">
            <div class="card shadow h-100">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Thông tin khách hàng</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-borderless">
                            <tr>
                                <th>Khách hàng:</th>
                                <td>@Model.FullName</td>
                            </tr>
                            <tr>
                                <th>Email:</th>
                                <td>@Model.Email</td>
                            </tr>
                            <tr>
                                <th>Số điện thoại:</th>
                                <td>@Model.PhoneNumber</td>
                            </tr>
                            <tr>
                                <th>Địa chỉ giao hàng:</th>
                                <td>@Model.ShippingAddress</td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cập nhật trạng thái -->
        <div class="col-xl-4 col-md-12 mb-4">
            <div class="card shadow h-100">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Cập nhật trạng thái</h6>
                </div>
                <div class="card-body">
                    <form asp-action="UpdateStatus" method="post" class="mb-3">
                        <input type="hidden" name="id" value="@Model.Id" />
                        
                        <div class="mb-3">
                            <label for="status" class="form-label">Trạng thái đơn hàng</label>
                            <select name="status" id="status" class="form-select">
                                @foreach (var status in Enum.GetValues(typeof(WebLapTop.Models.Entities.OrderStatus)))
                                {
                                    <option value="@status" @(Model.Status == status.ToString() ? "selected" : "")>@status</option>
                                }
                            </select>
                        </div>
                        
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i>Cập nhật trạng thái
                        </button>
                    </form>
                    
                    <div class="alert alert-info">
                        <h6><i class="fas fa-info-circle me-1"></i>Lưu ý:</h6>
                        <small>
                            <ul class="mb-0">
                                <li>Khi hủy đơn hàng, số lượng sản phẩm sẽ được hoàn trả vào kho.</li>
                                <li>Khách hàng sẽ nhận được thông báo khi trạng thái đơn hàng thay đổi.</li>
                            </ul>
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Chi tiết sản phẩm -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Chi tiết sản phẩm</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Sản phẩm</th>
                            <th>Đơn giá</th>
                            <th>Số lượng</th>
                            <th>Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderDetails)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        @if (!string.IsNullOrEmpty(item.Product?.ImageUrl))
                                        {
                                            <img src="@item.Product.ImageUrl" alt="@item.Product.Name" class="img-thumbnail me-3" style="width: 50px; height: 50px; object-fit: contain;" />
                                        }
                                        <div>
                                            <div class="fw-bold">@(item.Product?.Name ?? "Sản phẩm không còn tồn tại")</div>
                                            <small class="text-muted">ID: @item.ProductId</small>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-end">@item.UnitPrice.ToString("#,##0") ₫</td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-end">@((item.UnitPrice * item.Quantity).ToString("#,##0")) ₫</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="text-end fw-bold">Tổng cộng:</td>
                            <td class="text-end fw-bold">@Model.TotalAmount.ToString("#,##0") ₫</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div> 